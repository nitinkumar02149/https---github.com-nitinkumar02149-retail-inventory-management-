PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
MONGODB_URI=mongodb://127.0.0.1:27017/retail_inventory?replicaSet=retail-rs
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_COOKIE_MAX_AGE_MS=900000
SESSION_COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
DEFAULT_TAX_RATE=0.08
DEMO_ADMIN_NAME=Demo Administrator
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_a_local_admin_password
DEMO_STAFF_NAME=Demo Staff
DEMO_STAFF_EMAIL=staff@example.test
DEMO_STAFF_PASSWORD=replace_with_a_local_staff_password